---
import { SITE } from '../consts';
import ThemeSwitcher from './ThemeSwitcher.astro';

const pathname = Astro.url.pathname;

const navLinks = [
	{ href: '/categories/', label: '分类' },
	{ href: '/why/', label: 'WHY' },
	{ href: '/know/', label: 'Know' },
	{ href: '/news/', label: '新闻' },
	{ href: '/about/', label: '关于' },
];

function isActive(href: string): boolean {
	return pathname.startsWith(href);
}
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="/">
			<!-- 品牌 Logo(public 静态资源,用户提供) -->
			<img class="brand-logo" src="/kw-logo-彩色.svg" alt="KnowWhy" width="45" height="30" />
			<!-- 品牌名与中文名:逐字上推浮现的交替切换动画(每字独立遮罩,字符间错峰) -->
			<span class="brand-switcher" aria-label={`${SITE.name} | ${SITE.nameZh}`}>
				<span class="brand-item brand-en" aria-hidden="true">
					{SITE.name.split('').map((ch, i) => (
						<span class="brand-char" style={`--d: ${i * 40}ms`}>
							<span>{ch}</span>
						</span>
					))}
				</span>
				<span class="brand-item brand-zh" aria-hidden="true">
					{[...SITE.nameZh].map((ch, i) => (
						<span class="brand-char" style={`--d: ${i * 40}ms`}>
							<span>{ch}</span>
						</span>
					))}
				</span>
			</span>
		</a>
		<nav id="site-nav" class="site-nav" aria-label="主导航">
			{
				navLinks.map((link) => (
					<a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
						{link.label}
					</a>
				))
			}
			<!-- 搜索入口:图标 Search4(矢量数据取自 reicon-react 包) -->
			<a
				href="/search/"
				class:list={['nav-link', 'nav-link-search', { active: isActive('/search/') }]}
				aria-label="搜索"
				title="搜索"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
				>
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M16.489 17.5497C14.8753 18.922 12.7843 19.75 10.5 19.75C5.39137 19.75 1.25 15.6086 1.25 10.5C1.25 5.39137 5.39137 1.25 10.5 1.25C15.6086 1.25 19.75 5.39137 19.75 10.5C19.75 12.7843 18.922 14.8753 17.5497 16.489L22.5303 21.4697C22.8232 21.7626 22.8232 22.2374 22.5303 22.5303C22.2374 22.8232 21.7626 22.8232 21.4697 22.5303L16.489 17.5497ZM2.75 10.5C2.75 6.21979 6.21979 2.75 10.5 2.75C14.7802 2.75 18.25 6.21979 18.25 10.5C18.25 12.589 17.4235 14.485 16.0796 15.8788C16.0408 15.905 16.004 15.9353 15.9697 15.9697C15.9353 16.004 15.905 16.0408 15.8788 16.0796C14.485 17.4235 12.589 18.25 10.5 18.25C6.21979 18.25 2.75 14.7802 2.75 10.5Z"
						fill="currentColor"></path>
				</svg>
				<!-- 窄屏汉堡面板内显示文字,与其余导航项一致(桌面保持纯图标) -->
				<span class="nav-search-label">搜索</span>
			</a>
		</nav>
		<!-- 配色主题切换(默认 / Claude 暖调;新增主题见 ThemeSwitcher.astro) -->
		<ThemeSwitcher />
		<!-- 汉堡菜单按钮:仅窄屏显示;图标矢量数据取自 reicon-react 包(Menu,O 权重) -->
		<button
			class="nav-toggle"
			type="button"
			aria-label="打开菜单"
			aria-expanded="false"
			aria-controls="site-nav"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				aria-hidden="true"
			>
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M20.75 7C20.75 7.41421 20.4142 7.75 20 7.75L4 7.75C3.58579 7.75 3.25 7.41421 3.25 7C3.25 6.58579 3.58579 6.25 4 6.25L20 6.25C20.4142 6.25 20.75 6.58579 20.75 7Z"
					fill="currentColor"></path>
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M20.75 12C20.75 12.4142 20.4142 12.75 20 12.75L4 12.75C3.58579 12.75 3.25 12.4142 3.25 12C3.25 11.5858 3.58579 11.25 4 11.25L20 11.25C20.4142 11.25 20.75 11.5858 20.75 12Z"
					fill="currentColor"></path>
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M20.75 17C20.75 17.4142 20.4142 17.75 20 17.75L4 17.75C3.58579 17.75 3.25 17.4142 3.25 17C3.25 16.5858 3.58579 16.25 4 16.25L20 16.25C20.4142 16.25 20.75 16.5858 20.75 17Z"
					fill="currentColor"></path>
			</svg>
		</button>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: var(--glass);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.35rem;
		height: 64px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	.brand-logo {
		height: 30px;
		width: auto;
	}

	.brand-switcher {
		display: inline-grid;
		overflow: hidden;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.5;
		letter-spacing: -0.01em;
	}

	.brand-item {
		grid-area: 1 / 1;
		display: inline-flex;
		white-space: nowrap;
	}

	/* 逐字遮罩:每个字符在自身遮罩内上下滑动(与首页标题同款逐字上推浮现) */
	.brand-char {
		display: inline-block;
		overflow: hidden;
	}

	/* --d 为字符级错峰延迟(模板内联);both 保证延迟期间停留在起始帧,避免闪现 */
	.brand-char > span {
		display: inline-block;
		animation: brand-char-swap 6s cubic-bezier(0.45, 0, 0.25, 1) infinite both;
		animation-delay: var(--d);
	}

	.brand-en {
		color: var(--ink-deep);
	}

	.brand-zh {
		color: var(--text-muted);
	}

	/* 中文名整体错开半周期,与英文名交替轮换,同时保留逐字错峰 */
	.brand-zh .brand-char > span {
		animation-delay: calc(-2.7s + var(--d));
	}

	@keyframes brand-char-swap {
		0% {
			transform: translateY(115%);
			opacity: 0;
		}

		8%,
		45% {
			transform: translateY(0);
			opacity: 1;
		}

		53%,
		100% {
			transform: translateY(-115%);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-char > span {
			animation: none;
		}

		/* 停播后仅保留英文名常显,避免中英文重叠 */
		.brand-zh {
			display: none;
		}
	}

	/* 右侧留白由导航吸收:桌面端导航与主题切换器整体贴右 */
	.site-nav {
		display: flex;
		gap: 0.25rem;
		margin-left: auto;
	}

	.nav-link {
		padding: 0.4rem 0.75rem;
		font-size: 0.92rem;
		color: var(--text);
		transition: color 150ms ease;
	}

	/* 悬停与选中均不使用按钮底色:仅颜色变深、字重加粗 */
	.nav-link:hover {
		color: var(--ink-deep);
	}

	.nav-link.active {
		font-weight: 700;
		color: var(--ink-deep);
	}

	/* 搜索图标链接:与文字导航同高对齐 */
	.nav-link-search {
		display: inline-flex;
		align-items: center;
	}

	.nav-link-search svg {
		display: block;
	}

	/* 搜索项文字:仅窄屏汉堡面板内显示(桌面保持纯图标) */
	.nav-search-label {
		display: none;
	}

	/* 汉堡菜单按钮:仅窄屏显示(24px 图标 + 内边距保证触控目标) */
	.nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		padding: 0.45rem;
		border: none;
		border-radius: var(--radius-sm);
		background: none;
		color: var(--text);
		cursor: pointer;
		transition: color 150ms ease, background 150ms ease;
	}

	.nav-toggle:hover {
		color: var(--ink-deep);
		background: color-mix(in srgb, var(--ink-deep) 6%, transparent);
	}

	.nav-toggle svg {
		display: block;
	}

	/* 窄屏:导航整体收进汉堡菜单(下拉面板),头部保持单行;
	   面板定位基准为吸顶头部,点击导航项/面板外区域或按 Esc 收起 */
	@media (max-width: 720px) {
		.nav-toggle {
			display: inline-flex;
		}

		.site-nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.35rem 0.9rem 0.65rem;
			background: var(--glass-strong);
			backdrop-filter: blur(10px);
			border-bottom: 1px solid var(--line);
			box-shadow: 0 14px 28px color-mix(in srgb, var(--deep-bg) 8%, transparent);
		}

		.site-nav.is-open {
			display: flex;
		}

		.nav-link {
			padding: 0.7rem 0.35rem;
			border-bottom: 1px solid var(--line);
		}

		.nav-link:last-child {
			border-bottom: none;
		}

		.nav-link-search {
			gap: 0.55rem;
		}

		.nav-search-label {
			display: inline;
		}
	}

	@media (max-width: 640px) {
		.brand-switcher {
			font-size: 1.2rem;
		}
	}
</style>

<script>
	// 窄屏汉堡菜单:切换主导航面板显隐;点击导航链接、面板外区域或按 Esc 时收起
	const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const siteNav = document.getElementById('site-nav');

	if (navToggle && siteNav) {
		const setOpen = (open: boolean) => {
			siteNav.classList.toggle('is-open', open);
			navToggle.setAttribute('aria-expanded', String(open));
			navToggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
		};

		navToggle.addEventListener('click', () => setOpen(!siteNav.classList.contains('is-open')));

		siteNav.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		document.addEventListener('click', (event) => {
			if (!siteNav.classList.contains('is-open')) return;
			const target = event.target as Node;
			if (!siteNav.contains(target) && !navToggle.contains(target)) setOpen(false);
		});
	}
</script>
