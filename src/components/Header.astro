---
import { SITE } from '../consts';

const pathname = Astro.url.pathname;

const navLinks = [
	{ href: '/categories/', label: '分类' },
	{ href: '/why/', label: 'WHY' },
	{ href: '/know/', label: 'Know' },
	{ href: '/news/', label: '新闻' },
	{ href: '/about/', label: '关于' },
];

function isActive(href: string): boolean {
	return pathname.startsWith(href);
}
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="/">
			<!-- 品牌 Logo(public 静态资源,用户提供) -->
			<img class="brand-logo" src="/kw-logo-彩色.svg" alt="KnowWhy" width="45" height="30" />
			<!-- 品牌名与中文名:上下滑动 + 透明度渐变的交替切换动画 -->
			<span class="brand-switcher" aria-label={`${SITE.name} | ${SITE.nameZh}`}>
				<span class="brand-item brand-en" aria-hidden="true">{SITE.name}</span>
				<span class="brand-item brand-zh" aria-hidden="true">{SITE.nameZh}</span>
			</span>
		</a>
		<nav class="site-nav" aria-label="主导航">
			{
				navLinks.map((link) => (
					<a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
						{link.label}
					</a>
				))
			}
			<!-- 搜索入口:图标 Search4(矢量数据取自 reicon-react 包) -->
			<a
				href="/search/"
				class:list={['nav-link', 'nav-link-search', { active: isActive('/search/') }]}
				aria-label="搜索"
				title="搜索"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
				>
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M16.489 17.5497C14.8753 18.922 12.7843 19.75 10.5 19.75C5.39137 19.75 1.25 15.6086 1.25 10.5C1.25 5.39137 5.39137 1.25 10.5 1.25C15.6086 1.25 19.75 5.39137 19.75 10.5C19.75 12.7843 18.922 14.8753 17.5497 16.489L22.5303 21.4697C22.8232 21.7626 22.8232 22.2374 22.5303 22.5303C22.2374 22.8232 21.7626 22.8232 21.4697 22.5303L16.489 17.5497ZM2.75 10.5C2.75 6.21979 6.21979 2.75 10.5 2.75C14.7802 2.75 18.25 6.21979 18.25 10.5C18.25 12.589 17.4235 14.485 16.0796 15.8788C16.0408 15.905 16.004 15.9353 15.9697 15.9697C15.9353 16.004 15.905 16.0408 15.8788 16.0796C14.485 17.4235 12.589 18.25 10.5 18.25C6.21979 18.25 2.75 14.7802 2.75 10.5Z"
						fill="currentColor"></path>
				</svg>
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: rgb(255 255 255 / 85%);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	.brand-logo {
		height: 30px;
		width: auto;
	}

	.brand-switcher {
		display: inline-grid;
		overflow: hidden;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.5;
		letter-spacing: -0.01em;
	}

	.brand-item {
		grid-area: 1 / 1;
		white-space: nowrap;
		opacity: 0;
		animation: brand-swap 6s cubic-bezier(0.45, 0, 0.25, 1) infinite;
	}

	.brand-en {
		color: var(--ink-deep);
	}

	.brand-zh {
		color: var(--text-muted);
		animation-delay: -2.7s;
	}

	@keyframes brand-swap {
		0% {
			transform: translateY(115%);
			opacity: 0;
		}

		8%,
		45% {
			transform: translateY(0);
			opacity: 1;
		}

		53%,
		100% {
			transform: translateY(-115%);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-item {
			animation: none;
		}

		.brand-en {
			opacity: 1;
		}
	}

	.site-nav {
		display: flex;
		gap: 0.25rem;
	}

	.nav-link {
		padding: 0.4rem 0.75rem;
		font-size: 0.92rem;
		color: var(--text);
		transition: color 150ms ease;
	}

	/* 悬停与选中均不使用按钮底色:仅颜色变深、字重加粗 */
	.nav-link:hover {
		color: var(--ink-deep);
	}

	.nav-link.active {
		font-weight: 700;
		color: var(--ink-deep);
	}

	/* 搜索图标链接:与文字导航同高对齐 */
	.nav-link-search {
		display: inline-flex;
		align-items: center;
	}

	.nav-link-search svg {
		display: block;
	}

	/* 窄屏:品牌行 + 导航行两行布局,导航项自动换行 */
	@media (max-width: 720px) {
		.header-inner {
			flex-wrap: wrap;
			height: auto;
			padding-block: 0.6rem;
			row-gap: 0.45rem;
		}

		.site-nav {
			width: 100%;
			justify-content: center;
			flex-wrap: wrap;
		}
	}

	@media (max-width: 640px) {
		.brand-switcher {
			font-size: 1.2rem;
		}

		.nav-link {
			padding: 0.35rem 0.6rem;
			font-size: 0.88rem;
		}
	}
</style>
