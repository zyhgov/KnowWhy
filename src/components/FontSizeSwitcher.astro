---
/**
 * 阅读字号切换器(小 / 中 / 大):
 * 点击设置 html[data-font-size],由 global.css 的 --reading-size 变量驱动 .prose 字号;
 * 偏好写入 localStorage,之后打开任意文章持续生效。纯原生脚本,无需 React 岛。
 */
---

<div class="font-switcher" role="group" aria-label="正文字号">
	<button type="button" data-size="small" aria-pressed="false">小</button>
	<button type="button" data-size="medium" aria-pressed="true">中</button>
	<button type="button" data-size="large" aria-pressed="false">大</button>
</div>

<script>
	const STORAGE_KEY = 'knowwhy:font-size';
	const root = document.documentElement;
	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.font-switcher button[data-size]'),
	);

	const readStored = () => {
		try {
			return localStorage.getItem(STORAGE_KEY) ?? 'medium';
		} catch {
			return 'medium';
		}
	};

	const apply = (size: string) => {
		if (size === 'small' || size === 'large') {
			root.dataset.fontSize = size;
		} else {
			root.removeAttribute('data-font-size');
		}
		for (const button of buttons) {
			button.setAttribute('aria-pressed', String(button.dataset.size === size));
		}
	};

	apply(readStored());

	for (const button of buttons) {
		button.addEventListener('click', () => {
			const size = button.dataset.size ?? 'medium';
			try {
				localStorage.setItem(STORAGE_KEY, size);
			} catch {
				// localStorage 不可用时仅本次会话生效
			}
			apply(size);
		});
	}
</script>

<style>
	.font-switcher {
		display: inline-flex;
		margin-left: auto;
		border: 1px solid var(--line);
		border-radius: 999px;
		overflow: hidden;
		background: var(--paper);
	}

	.font-switcher button {
		padding: 0.28rem 0.72rem;
		border: none;
		background: transparent;
		font: inherit;
		font-size: 0.8rem;
		color: var(--text-muted);
		cursor: pointer;
		transition:
			background 150ms ease,
			color 150ms ease;
	}

	.font-switcher button + button {
		border-left: 1px solid var(--line);
	}

	.font-switcher button:hover {
		color: var(--ink-deep);
	}

	.font-switcher button[aria-pressed='true'] {
		background: var(--ink);
		color: #fff;
	}

	/* 小屏:收窄按钮,避免挤占文章元信息行 */
	@media (max-width: 640px) {
		.font-switcher button {
			padding: 0.18rem 0.5rem;
			font-size: 0.72rem;
		}
	}
</style>
