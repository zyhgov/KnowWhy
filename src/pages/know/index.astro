---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowCard from '../../components/KnowCard.astro';
import EntriesToolbar from '../../components/EntriesToolbar.astro';
import { formatAuthorNames, getCategory } from '../../consts';
import { byNewest, formatDate, getKnowHref } from '../../utils';

// KNOW 编号总目录:全部已发布知识点,最新在前(日期倒序,同日按编号倒序)
const entries = (await getCollection('know', ({ data }) => data.status === 'published')).sort(byNewest);
---

<BaseLayout
	title="Know · 你知道吗"
	description="KnowWhy「Know」内容线:KNOW 编号收录「你知道吗」式的趣味知识点——规模不大,同样让人恍然大悟。"
>
	<nav class="crumbs" aria-label="面包屑">
		<ol>
			<li><a href="/">首页</a></li>
			<li aria-current="page">Know</li>
		</ol>
	</nav>

	<header class="page-head">
		<h1>Know · 你知道吗</h1>
		<p>
			「你知道吗」内容线:KNOW 编号收录那些规模不大、却很值得一说的知识点——一条冷知识,一个「原来如此」的瞬间。
		</p>
	</header>

	{
		entries.length > 0 ? (
			<div class="entries-browser" data-per-page="10" data-default-view="card">
				<EntriesToolbar total={entries.length} defaultView="card" />
				<ul class="why-list why-list-wide" data-view-panel="card">
					{entries.map((entry) => (
						<li data-entry>
							<KnowCard entry={entry} wide />
						</li>
					))}
				</ul>
				<div class="entries-table-wrap" data-view-panel="list" hidden>
					<table class="entries-table">
						<thead>
							<tr>
								<th>编号</th>
								<th>标题</th>
								<th>分类</th>
								<th>标签</th>
								<th>日期</th>
								<th>作者</th>
							</tr>
						</thead>
						<tbody>
							{entries.map((entry) => (
								<tr data-entry>
									<td class="cell-id">{entry.data.id}</td>
									<td>
										<a href={getKnowHref(entry)}>{entry.data.title}</a>
									</td>
									<td>{getCategory(entry.data.category)?.name}</td>
									<td>{entry.data.tags.join(' / ')}</td>
									<td>{formatDate(entry.data.date)}</td>
									<td>{formatAuthorNames(entry.data.authors)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<nav class="entries-pager" data-pager aria-label="分页" hidden></nav>
			</div>
		) : (
			<div class="empty">
				<p>这条内容线正在筹备中——第一则「你知道吗」很快就会与你见面。</p>
			</div>
		)
	}
</BaseLayout>

<script>
	import '../../scripts/entries-browser';
</script>

<style>
	.page-head {
		margin-block: 1.25rem 2rem;
	}

	.page-head h1 {
		font-size: clamp(1.6rem, 3.5vw, 2.1rem);
	}

	.page-head p {
		max-width: 56ch;
		margin-top: 0.5rem;
		color: var(--text-muted);
	}

	.empty {
		padding: 3rem 1.5rem;
		text-align: center;
		color: var(--text-muted);
		border: 1px dashed var(--line);
		border-radius: var(--radius-md);
		background: var(--paper);
	}

	/* 表格视图中的 KNOW 编号:蓝色 */
	.cell-id {
		color: var(--blue-deep);
	}
</style>
