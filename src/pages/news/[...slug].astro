---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHead from '../../components/ArticleHead.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticleNav from '../../components/ArticleNav.astro';
import ArticleShare from '../../components/ArticleShare.astro';
import ArticleJsonLd from '../../components/ArticleJsonLd.astro';
import { getAuthor } from '../../consts';
import { formatDate, getNewsHref } from '../../utils';

// 为所有已发布新闻生成详情页:/news/<slug>/
export const getStaticPaths = (async () => {
	// 站点新闻无编号字段,按发布日期倒序(同日按文件 id 稳定排序)
	const entries = (await getCollection('news', ({ data }) => data.status === 'published')).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
	);
	return entries.map((entry, index) => ({
		params: { slug: entry.id },
		// 上一篇/下一篇:按发布时间取相邻(index+1 更早、index-1 更晚,最新/最早一条自动缺省)
		props: { entry, prevEntry: entries[index + 1], nextEntry: entries[index - 1] },
	}));
}) satisfies GetStaticPaths;

interface Props {
	entry: CollectionEntry<'news'>;
	/** 上一篇(发布时间更早);最早一条时为 undefined */
	prevEntry?: CollectionEntry<'news'>;
	/** 下一篇(发布时间更晚);最新一条时为 undefined */
	nextEntry?: CollectionEntry<'news'>;
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

// SEO:描述文案与作者显示名,供 BaseLayout(meta)与 ArticleJsonLd(结构化数据)共用
const pageDescription = data.summary ?? `${data.title} —— KnowWhy 站点新闻。`;
const authorNames = data.authors.map((key) => getAuthor(key)?.name ?? key);
---

<BaseLayout
	title={data.title}
	description={pageDescription}
	ogType="article"
	ogImage={data.ogImage}
	article={{
		publishedTime: data.date.toISOString(),
		authors: authorNames,
		section: '站点新闻',
		tags: data.tags,
	}}
	author={authorNames.join('、')}
>
	<Fragment slot="after-header">
		<ArticleToc headings={headings} />
	</Fragment>

	<article class="article">
		<nav class="crumbs" aria-label="面包屑">
			<ol>
				<li><a href="/">首页</a></li>
				<li><a href="/news/">站点新闻</a></li>
				<li aria-current="page">{formatDate(data.date)}</li>
			</ol>
		</nav>

		<ArticleHead date={data.date} title={data.title} tags={data.tags} authors={data.authors} />

		{data.summary && <p class="news-lead">{data.summary}</p>}

		<div class="prose">
			<Content />
		</div>

		<ArticleShare title={data.title} />

		<ArticleNav
			prev={prevEntry ? { title: prevEntry.data.title, href: getNewsHref(prevEntry) } : undefined}
			next={nextEntry ? { title: nextEntry.data.title, href: getNewsHref(nextEntry) } : undefined}
		/>
	</article>

	<Fragment slot="head">
		<ArticleJsonLd
			title={data.title}
			description={pageDescription}
			datePublished={data.date.toISOString()}
			authors={data.authors}
			section="站点新闻"
			keywords={data.tags}
			ogImage={data.ogImage}
			crumbs={[
				{ name: '首页', url: '/' },
				{ name: '站点新闻', url: '/news/' },
				{ name: formatDate(data.date) },
			]}
		/>
	</Fragment>
</BaseLayout>

<script>
	import '../../scripts/code-enhance';
	import '../../scripts/mermaid-render';
</script>

<style>
	.article {
		max-width: 860px;
		margin-inline: auto;
	}

	.news-lead {
		margin-top: -1rem;
		margin-bottom: 1.75rem;
		font-size: 1.05rem;
		color: var(--text-muted);
	}
</style>
