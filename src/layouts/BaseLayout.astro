---
import { SEO } from 'astro-seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/react/BackToTop.tsx';
import { SITE } from '../consts';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/noto-sans-sc/600.css';
import '@fontsource/noto-sans-sc/700.css';
// KaTeX 数学公式样式(remark-math/rehype-katex 渲染的 $...$ / $$...$$);字体随包本地打包
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
	/** 页面标题(不含站点后缀);不传时使用站点全称 */
	title?: string;
	description?: string;
	/** og:type,文章页传 'article' */
	ogType?: 'website' | 'article';
	/** 页面自定义 og:image(public 下绝对路径);缺省用站点默认图 */
	ogImage?: string;
	/** og:article 系列(仅 ogType='article' 时输出):发布日期(ISO)/作者显示名/板块/标签 */
	article?: {
		publishedTime: string;
		authors?: string[];
		section?: string;
		tags?: string[];
	};
	/** 页面作者显示名(输出 meta author) */
	author?: string;
	/** 禁止搜索引擎索引(404 / 站内搜索等) */
	noindex?: boolean;
}

const {
	title,
	description = SITE.description,
	ogType = 'website',
	ogImage,
	article,
	author,
	noindex = false,
} = Astro.props;

const siteName = `${SITE.name}|${SITE.nameZh}`;
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} — ${SITE.tagline}`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
// 未设置或空字符串一律回退默认图(?? 只拦 null/undefined,而 new URL('', SITE.url) 会解析成站点根)
const ogImageURL = new URL(ogImage?.trim() || '/kw-og-images.jpg', SITE.url);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<!-- 站点图标(public/icon 全套) -->
		<link rel="apple-touch-icon" sizes="57x57" href="/icon/apple-icon-57x57.png" />
		<link rel="apple-touch-icon" sizes="60x60" href="/icon/apple-icon-60x60.png" />
		<link rel="apple-touch-icon" sizes="72x72" href="/icon/apple-icon-72x72.png" />
		<link rel="apple-touch-icon" sizes="76x76" href="/icon/apple-icon-76x76.png" />
		<link rel="apple-touch-icon" sizes="114x114" href="/icon/apple-icon-114x114.png" />
		<link rel="apple-touch-icon" sizes="120x120" href="/icon/apple-icon-120x120.png" />
		<link rel="apple-touch-icon" sizes="144x144" href="/icon/apple-icon-144x144.png" />
		<link rel="apple-touch-icon" sizes="152x152" href="/icon/apple-icon-152x152.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/icon/apple-icon-180x180.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon/android-icon-192x192.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/icon/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/icon/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/icon/favicon-16x16.png" />
		<link rel="manifest" href="/icon/manifest.json" />
		<meta name="msapplication-TileColor" content="#ffffff" />
		<meta name="msapplication-TileImage" content="/icon/ms-icon-144x144.png" />
		<meta name="theme-color" content="#ffffff" />
		<!-- astro-seo:基础 meta(title / description / canonical / robots)+ openGraph + twitter → 卡片 -->
		<SEO
			title={fullTitle}
			description={description}
			canonical={canonicalURL}
			noindex={noindex}
			twitter={{
				card: 'summary_large_image',
				title: fullTitle,
				description,
				image: ogImageURL.href,
				imageAlt: siteName,
			}}
			openGraph={{
				basic: {
					title: fullTitle,
					type: ogType,
					image: ogImageURL.href,
					url: canonicalURL,
				},
				image: {
					alt: siteName,
				},
				article,
				optional: {
					locale: 'zh_CN',
					siteName,
					description,
				},
			}}
			extend={author ? { meta: [{ name: 'author', content: author }] } : undefined}
		/>
		{/*
			SEO 预留:Schema.org 结构化数据注入位。
			首页通过 <Fragment slot="head"> 注入 FAQPage,文章页注入 Article(JSON-LD)。
		*/}
		<slot name="head" />
		<!-- Microsoft Clarity 行为分析(全站,项目 ID:yh39o7mjvy) -->
		<script is:inline>
			(function(c,l,a,r,i,t,y){
				c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
				t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
				y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
			})(window, document, "clarity", "script", "yh39o7mjvy");
		</script>
		<!-- 51.LA 网站统计(同步引入,id: LJhpuVmQONPz46Gl) -->
		<script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js" is:inline></script>
		<script is:inline>
			LA.init({id:"LJhpuVmQONPz46Gl",ck:"LJhpuVmQONPz46Gl",autoTrack:true,hashMode:true})
		</script>
	</head>
	<body>
		<Header />
		{/* 紧贴导航栏下方的粘滞元素插槽(如文章目录条) */}
		<slot name="after-header" />
		<main class="site-main">
			<slot />
		</main>
		<Footer />
		{/*
			全站唯一的常驻 React 交互组件;纯浏览器交互(滚动监听),SSR 输出无意义,
			用 client:only 跳过服务端渲染——同时规避 dev 下 SSR 预打包异常对 hooks 的影响。
		*/}
		<BackToTop client:only="react" />
	</body>
</html>
